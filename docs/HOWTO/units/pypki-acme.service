[Unit]
Description=PyPKI ACME Server (RFC 8555)
Documentation=file:///opt/pypki/docs/HOWTO/acme.md
After=network.target
Wants=network.target

[Service]
Type=notify
User=pypki
Group=pypki
WorkingDirectory=/opt/pypki
ExecStart=/opt/pypki/venv/bin/python3 pki_server.py \
    --ca-dir /var/lib/pypki/ca \
    --port 8080 \
    --acme-prefix /acme \
    --acme-base-url http://pki.internal:8080/acme \
    --ocsp-url http://pki.internal:8080/ocsp \
    --crl-url http://pki.internal:8080/ca/crl \
    --web-prefix / \
    --log-level INFO

Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30

# Hardening
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/pypki
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
